@startuml Diagrama de Despliegue - PharmaGo K8s
!theme plain
skinparam backgroundColor #FAFAFA
skinparam defaultFontSize 11
skinparam rectangleBorderThickness 2
skinparam nodeBorderThickness 2
skinparam componentStyle rectangle

title **Diagrama de Despliegue - PharmaGo sobre Kubernetes**\nNamespace: pharmago

' ============================================================
' KUBERNETES CLUSTER
' ============================================================
node "<<Kubernetes Cluster>>\nPharmaGo" as cluster {

  ' ============================================================
  ' NODO FRONTEND (verde claro)
  ' ============================================================
  node "<<K8s Node>>\nnode-type: frontend" as frontendNode #D5F5D5 {

    rectangle "<<Deployment>>\n**pharmago-ui**\nAngular App\nReplicas: 1" as ui #C8E6C9 {
    }
    rectangle "<<Service: NodePort>>\npharmago-ui\n:80" as uiSvc #A5D6A7
  }

  ' ============================================================
  ' NODO BACKEND (azul claro)
  ' ============================================================
  node "<<K8s Node>>\nnode-type: backend" as backendNode #D6E4F0 {

    rectangle "<<Deployment>>\n**pharmago-api-gateway**\nASP.NET Core + YARP\nReplicas: 1" as apigw #BBDEFB {
    }
    rectangle "<<Service: ClusterIP>>\npharmago-api-gateway\n:80" as apigwSvc #90CAF9

    rectangle "<<Deployment>>\n**pharmago-users-service**\nASP.NET Core\nReplicas: 1" as users #BBDEFB {
    }
    rectangle "<<Service: ClusterIP>>\npharmago-users-service\n:80" as usersSvc #90CAF9

    rectangle "<<Deployment>>\n**pharmago-pharmacy-service**\nASP.NET Core\nReplicas: 1" as pharmacy #BBDEFB {
    }
    rectangle "<<Service: ClusterIP>>\npharmago-pharmacy-service\n:80" as pharmacySvc #90CAF9
  }

  ' ============================================================
  ' NODO OPS (rosa/salmón) - Datos
  ' ============================================================
  node "<<K8s Node>>\nnode-type: ops" as opsNode #FCE4EC {

    ' --- Base de datos ---
    rectangle "<<Deployment>>\n**pharmago-db**\nMSSQL Server 2019 Express\nReplicas: 1 | Strategy: Recreate" as db #F8BBD0 {
    }
    rectangle "<<Service: ClusterIP>>\npharmago-db\n:1433" as dbSvc #F48FB1
    database "<<PersistentVolume>>\nsql-pv\n10Gi" as sqlPV #E1BEE7

    ' --- Elasticsearch ---
    rectangle "<<Deployment>>\n**elasticsearch**\nSingle-node\nReplicas: 1 | Strategy: Recreate" as elastic #F8BBD0 {
    }
    rectangle "<<Service: ClusterIP>>\nelasticsearch\n:9200 / :9300" as elasticSvc #F48FB1
    database "<<PersistentVolume>>\nelasticsearch-pv\n10Gi" as esPV #E1BEE7

    ' --- Kibana ---
    rectangle "<<Deployment>>\n**kibana**\nReplicas: 1" as kibana #F8BBD0 {
    }
    rectangle "<<Service: NodePort>>\nkibana\n:5601" as kibanaSvc #F48FB1

    ' --- Prometheus ---
    rectangle "<<Deployment>>\n**prometheus**\nReplicas: 1 | Strategy: Recreate\nRetention: 30d" as prom #F8BBD0 {
    }
    rectangle "<<Service: NodePort>>\nprometheus\n:9090" as promSvc #F48FB1
    database "<<PersistentVolume>>\nprometheus-pv\n10Gi" as promPV #E1BEE7

    ' --- Grafana ---
    rectangle "<<Deployment>>\n**grafana**\nReplicas: 1" as grafana #F8BBD0 {
    }
    rectangle "<<Service: NodePort>>\ngrafana\n:3000" as grafanaSvc #F48FB1
    database "<<PersistentVolume>>\ngrafana-pv\n5Gi" as grafanaPV #E1BEE7

    ' --- OTLP Collector ---
    rectangle "<<Deployment>>\n**otlp-collector**\nOpenTelemetry Collector\nReplicas: 1" as otel #F8BBD0 {
    }
    rectangle "<<Service: ClusterIP>>\notlp-collector\n:4317 (gRPC) / :8889 (prom)" as otelSvc #F48FB1
  }

  ' ============================================================
  ' DAEMONSETS (en todos los nodos)
  ' ============================================================
  node "<<Todos los nodos>>" as allNodes #FFF9C4 {
    rectangle "<<DaemonSet>>\n**fluent-bit**\nLog collector\nLee: /var/log/containers/*.log" as fluentbit #FFF176
    rectangle "<<DaemonSet>>\n**node-exporter**\nNode metrics\n:9100 | hostNetwork: true" as nodeexp #FFF176
  }
}

' ============================================================
' USUARIO EXTERNO
' ============================================================
actor "Usuario" as user

' ============================================================
' CONEXIONES - Tráfico de aplicación
' ============================================================
user -[#2E7D32]-> uiSvc : "HTTP\n(NodePort)"
uiSvc --> ui
ui -[#2E7D32]-> apigwSvc : "HTTP :80"
apigwSvc --> apigw
apigw -[#1565C0]-> usersSvc : "HTTP :80\n(YARP Proxy)"
apigw -[#1565C0]-> pharmacySvc : "HTTP :80\n(YARP Proxy)"
usersSvc --> users
pharmacySvc --> pharmacy
users -[#1565C0,dashed]-> pharmacySvc : "HTTP :80"
pharmacy -[#1565C0,dashed]-> usersSvc : "HTTP :80"
users -[#6A1B9A]-> dbSvc : "TCP :1433"
pharmacy -[#6A1B9A]-> dbSvc : "TCP :1433"
dbSvc --> db

' ============================================================
' CONEXIONES - Telemetría y métricas
' ============================================================
' Servicios envían métricas OTLP al collector
apigw -[#E65100,dotted]-> otelSvc : "gRPC :4317\n(OTLP)"
users -[#E65100,dotted]-> otelSvc : "gRPC :4317\n(OTLP)"
pharmacy -[#E65100,dotted]-> otelSvc : "gRPC :4317\n(OTLP)"
otelSvc --> otel

' Prometheus scrapes
prom -[#C62828,dotted]-> otelSvc : "scrape :8889"
prom -[#C62828,dotted]-> apigwSvc : "scrape :80/metrics"
prom -[#C62828,dotted]-> usersSvc : "scrape :80/metrics"
prom -[#C62828,dotted]-> pharmacySvc : "scrape :80/metrics"
prom -[#C62828,dotted]-> nodeexp : "scrape :9100"

' Grafana consume Prometheus
grafana -[#AD1457]-> promSvc : "HTTP :9090"
promSvc --> prom

' Fluent Bit envía logs a Elasticsearch
fluentbit -[#F57F17,dotted]-> elasticSvc : "HTTP :9200\n(logs → pharmago-logs-*)"
elasticSvc --> elastic

' Kibana consume Elasticsearch
kibana -[#AD1457]-> elasticSvc : "HTTP :9200"

' Persistent volumes
db --> sqlPV
elastic --> esPV
prom --> promPV
grafana --> grafanaPV

' ============================================================
' ACCESO EXTERNO (NodePort)
' ============================================================
user -[#AD1457]-> grafanaSvc : "HTTP :3000\n(NodePort)"
user -[#AD1457]-> kibanaSvc : "HTTP :5601\n(NodePort)"

' ============================================================
' LEYENDA
' ============================================================
legend bottom left
  |= Color |= Significado |
  | <#D5F5D5> | Nodo Frontend |
  | <#D6E4F0> | Nodo Backend |
  | <#FCE4EC> | Nodo Ops (observabilidad + datos) |
  | <#FFF9C4> | DaemonSets (todos los nodos) |
  | <#E1BEE7> | PersistentVolumes (local-storage) |
  |= Línea |= Protocolo |
  | <color:#2E7D32>──</color> | HTTP (usuario → app) |
  | <color:#1565C0>──</color> | HTTP (inter-servicio) |
  | <color:#6A1B9A>──</color> | TCP (base de datos) |
  | <color:#E65100>╌╌</color> | gRPC / OTLP (telemetría) |
  | <color:#C62828>╌╌</color> | Prometheus scrape |
  | <color:#F57F17>╌╌</color> | Logs (Fluent Bit → ES) |
  | <color:#AD1457>──</color> | Consumo dashboards |
endlegend

@enduml
